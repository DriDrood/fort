@model Fort.Services.MapBaseService
@{
    ViewData["Title"] = "Mapa";
    ViewData["page"] = "map";
}

@Html.Raw(Model.Print())

<div id="actions">
    @if ((ViewData["player"] as Fort.Services.CurrentPlayerService)?.User?.IsAdmin == true)
    {
        <i class="fa fa-play" id="play" title="Začít hru"></i>
        <i class="fa fa-pause" id="pause" title="Pozastavit"></i>
        <i class="fa fa-step-forward" id="resume" title="Znovu spustit"></i>
        <i class="fa fa-stop" id="end" title="Ukončit kolo"></i>
    }
    <span id="time">0:00:00</span>
</div>