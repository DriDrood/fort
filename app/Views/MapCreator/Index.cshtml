@model Map
@{
    ViewData["Title"] = "Map Creator";
}

<svg id="mapCreator" width="1600" height="794">
    @foreach (var city in Model.Cities)
    {
        <circle cx="@city.X" cy="@city.Y" r="10" />
    }
    @foreach (var path in Model.Paths)
    {
        <line x1="@path.Source.X" y1="@path.Source.Y" x2="@path.Target.X" y2="@path.Target.Y" style="stroke:black;stroke-width:5" />
    }
</svg>

@Html.ActionLink("Upravit města", "Index")
@Html.ActionLink("Upravit cesty", "Paths")
