@model Fort.Services.MapBaseService
@{
    ViewData["Title"] = "Mapa";
    ViewData["page"] = "map";
}

<div id="map_holder">
    @Html.Raw(Model.Print())
</div>

<div class="shadow">
    <div id="sendArmy" class="modal">
        <div class="modal_header">

        </div>
        <div class="modal_content">
            <div id="armySlider" class="slider" data-target="armySize"><div class="slider_point"></div></div>
            <input id="armySize" type="number" min="0" max="0" value="0" data-source="armySlider" />
            <button value="sendArmy">Ok</button>
            <button value="cancel">Zrušit</button>
        </div>
    </div>
    <i class="fa fa-spinner fa-spin fa-fw"></i>
</div>

<div id="notification">
</div>

<div id="actions">
    @if ((ViewData["player"] as Fort.Services.CurrentPlayerService)?.User?.IsAdmin == true)
    {
        <i class="fa fa-play" id="play" title="Spustit hru"></i>
        <i class="fa fa-pause" id="pause" title="Pozastavit"></i>
        <i class="fa fa-stop" id="end" title="Ukončit kolo"></i>
    }
    <span class="round">@Html.Raw(Model.GetStatus())</span>
    <span class="time">@Model.GetRemaining()</span>
    <span class="connection"><i class="fa fa-chain-broken" title="Spojení se servererm přerušeno"></i></span>
</div>