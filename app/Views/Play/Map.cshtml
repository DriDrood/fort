@model Fort.Services.MapBaseService
@{
    Fort.Services.CurrentPlayerService currPlayer = (Fort.Services.CurrentPlayerService)ViewData["player"];
    ViewData["Title"] = "Mapa";
    ViewData["page"] = "map";
    ViewData["type"] = currPlayer.Player.GetType().Name;
    ViewData["playerName"] = currPlayer.Player.Name;
}

<div id="actions">
    @if (currPlayer?.User?.IsAdmin == true)
    {
        <i class="fa fa-play float-left" id="play" title="Spustit hru"></i>
        <i class="fa fa-pause float-left" id="pause" title="Pozastavit"></i>
        <i class="fa fa-fast-forward float-left" id="end" title="Ukončit kolo"></i>
        <i class="fa fa-refresh float-left" id="restart" title="Restartovat hru"></i>
    }
    @if (currPlayer?.User != null)
    {
        <i class="fa fa-flag-checkered float-left" id="ready" title="Připraven na další kolo"></i>
    }
    <span class="round float-left">@Html.Raw(Model.GetStatus())</span>
    <span class="connection float-right"><i class="fa fa-chain-broken" title="Spojení se servererm přerušeno"></i></span>
    <span class="time float-right">@Model.GetRemaining()</span>
</div>

<div id="map_holder">
    @Html.Raw(Model.Print())
</div>

@Html.Raw(Model.ShowStatistics())

<div class="shadow">
    <div id="sendArmy" class="modal">
        <div class="modal_header">
            Poslat armádu
        </div>
        <div class="modal_content">
            <div id="armySlider" class="slider" data-target="armySize"><div class="slider_point"></div></div>
            <input id="armySize" type="number" min="0" max="0" value="0" data-source="armySlider" />
            <button value="sendArmy">Ok</button>
            <button value="cancel">Zrušit</button>
        </div>
    </div>
    <i class="fa fa-spinner fa-spin fa-fw"></i>
</div>

<div id="notification">
</div>
