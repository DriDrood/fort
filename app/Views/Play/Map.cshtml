@using Fort.Module
@using Fort.Module.Army
@model ContextService
@{
    ContextService context = Model;
    RoundService roundService = Program.GetService<RoundService>();
    ArmyService armyService = context.GetArmyService();
    ViewData["Title"] = "Mapa";
    ViewData["page"] = "map";
    ViewData["type"] = context.CurrentPlayer.GetType().Name;
    ViewData["playerName"] = context.CurrentPlayer.Name;
}

<div id="actions">
    @if (context.CurrentPlayer.IsUser() && (context.CurrentPlayer as Fort.Database.Entities.User).IsAdmin)
    {
        <i class="fa fa-play float-left" id="play" title="Spustit hru"></i>
        <i class="fa fa-pause float-left" id="pause" title="Pozastavit"></i>
        <i class="fa fa-fast-forward float-left" id="end" title="Ukončit kolo"></i>
        <i class="fa fa-refresh float-left" id="restart" title="Restartovat hru"></i>
    }
    @if (context.CurrentPlayer.IsUser())
    {
        <i class="fa fa-check float-left" id="ready" title="Připraven na další kolo"></i>
    }
    <span id="roud" class="float-left"></span>
    <span id="connection" class="float-right"><i class="fa fa-chain-broken" title="Spojení se servererm přerušeno"></i></span>
    <span id="time" class="float-right">0:00:00</span>
</div>

<div id="map_holder">
    <svg id="map">
        <defs>
            <filter id="shadow"  filterUnits="userSpaceOnUse">
            <feDropShadow dx="0" dy="0" stdDeviation="5" flood-color="rgb(0, 173, 204)" flood-opacity="1" />
            </filter>
        </defs>
        <g id="paths"></g>
        <g id="turns"></g>
        <g id="cities"></g>
    </svg>
</div>

<div id="modal_shadow" style="display:none;">
    <div id="sendArmy" class="modal">
        <div class="modal_header">
            Poslat armádu
        </div>
        <div class="modal_content">
            <div id="armySlider" class="slider" data-target="armySize"><div class="slider_point"></div></div>
            <input id="armySize" type="number" min="0" max="0" value="0" data-source="armySlider" />
            <button value="sendArmy">Ok</button>
            <button value="cancel">Zrušit</button>
        </div>
    </div>
    <i id="modal_spinner" class="fa fa-spinner fa-spin fa-fw"></i>
</div>

<div id="notification">
</div>

<script>
        document.addEventListener('DOMContentLoaded', function () {
            Builder.INIT(@Html.Raw(armyService.GetInit().ToString()));
            @if (roundService.CurrentRound.EndsAt != null)
            {
                @:Utils.countDown.start(Date.parse(@roundService.CurrentRound.EndsAt?.ToString()));
            }
        }, false);
</script>
